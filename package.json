{
  "name": "drinkpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next build && next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.tests.json",
